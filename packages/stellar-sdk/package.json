{
  "name": "@parallax/stellar-sdk",
  "version": "0.1.0",
  "description": "Official TypeScript Developer SDK for Parallax on Stellar (Soroban smart contracts, SEP-10 WebAuth, SEP-38 quotes)",
  "type": "module",
  "author": "Parallax",
  "license": "MIT",
  "homepage": "https://web-mu-rosy-80.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/parallax-protocol/parallax.git",
    "directory": "packages/stellar-sdk"
  },
  "bugs": {
    "url": "https://github.com/parallax-protocol/parallax/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "import": "./dist/contracts/index.js",
      "default": "./dist/contracts/index.js"
    },
    "./sep": {
      "types": "./dist/sep/index.d.ts",
      "import": "./dist/sep/index.js",
      "default": "./dist/sep/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js",
      "default": "./dist/constants.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "@parallax/kernel": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
